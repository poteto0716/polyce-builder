# Stage 01: periodic-bulk relaxation.
# Select a section with: lmp -in <this-file> -var MODE <mode>

variable MODE index shake
if "${MODE} == shake" then "jump SELF mode_shake"
if "${MODE} == generic" then "jump SELF mode_generic"
print "invalid MODE ${MODE}"
quit 1

label mode_shake
# Stage 01: shared high-temperature periodic-bulk relaxation.
# Only X-H bond lengths are constrained.  The unconstrained PCFF-IFF
# Hamiltonian is restored after the two surface branches have been prepared.

variable STYLE      index polymer.in.styles
variable T_HIGH     index 550.0
variable DT_SHAKE   index 1.0
variable TDAMP      index 100.0
variable N_WARM     index 20000
variable N_HOT      index 180000

include         ${STYLE}
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          5000
thermo_style    custom step time temp pe ke etotal press density
thermo_modify   flush yes

# Relax the as-packed geometry without SHAKE restraints.  The subsequent MD
# starts with all X-H bonds close to their PCFF-IFF equilibrium lengths.
min_style       cg
minimize        1.0e-4 1.0e-6 10000 100000

velocity        all create 50.0 90210 mom yes rot yes dist gaussian
timestep        ${DT_SHAKE}

fix             WARM all nvt temp 50.0 ${T_HIGH} ${TDAMP}
fix             XH all shake 1.0e-6 200 5000 b 5 12 15
run             ${N_WARM}
unfix           XH
unfix           WARM

fix             HOT all nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
fix             XH all shake 1.0e-6 200 5000 b 5 12 15
run             ${N_HOT}
unfix           XH
unfix           HOT

write_data      bulk_shake.data
write_restart   bulk_shake.restart
jump SELF mode_end

label mode_generic
# Phase 1 -- relax the polymer melt, still fully periodic.
#
# PolyCE placed the chains and paid for the overlaps with its own local Monte
# Carlo (D002). That gives a structure with the right density, the right
# topology and a strained local geometry; this run is what turns it into a melt.
#
# Nothing here touches the boundary. The box stays p p p, because the whole
# point of the bulk-first route is that the polymer never sees a wall while it
# is being grown OR while it is being relaxed. It becomes a slab in phase 2,
# after its molecules have been made whole.
#
#   lmp -in in.01_polymer_relax.lmp -var poly ../polymer_bulk/output/polymer
#
variable poly    index polymer          # <prefix>.in.styles beside the run
variable T_HIGH  index 550.0
variable T_ROOM  index 300.0
variable TDAMP   index 100.0
variable DT      index 0.25          # fs; see D037 -- no SHAKE in a stock build
variable N_WARM  index 40000         # 10 ps ramp
variable N_HOT   index 400000        # 100 ps at T_HIGH
variable N_COOL  index 400000        # 100 ps 550 -> 300
variable N_ROOM  index 400000        # 100 ps at 300 K

include         ${poly}.in.styles

# Rebuild the neighbour list whenever it is needed, not on a schedule.
#
# LAMMPS defaults to `delay 10`, which skips the check for ten steps after a
# build. A melt at 550 K moves far enough in ten steps that a bonded partner can
# leave the list, and the run then stops with "Bond atoms missing" -- which it
# did here at step 63168 of a 60,320-atom relax that had been perfectly steady
# in temperature, energy and density up to that point. The smoke system was
# small enough never to hit it.
#
# A wider skin costs a little memory and rebuild time and buys a large margin.
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes


timestep        ${DT}
thermo          5000
thermo_style    custom step temp pe ke etotal press vol density
thermo_modify   flush yes

# The image flags PolyCE wrote are carried through every step below. Nothing
# here may wrap, remap or reset them: phase 2 needs them to make the molecules
# whole, and a run that quietly loses them has broken the workflow silently.

min_style       cg
minimize        1.0e-4 1.0e-6 10000 100000

velocity        all create 50.0 90210 mom yes rot yes dist gaussian
fix             WARM all nvt temp 50.0 ${T_HIGH} ${TDAMP}
run             ${N_WARM}
unfix           WARM

fix             HOT all nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
run             ${N_HOT}
unfix           HOT

# NPT only in x and y would strain the melt in the plane the substrate fixes,
# so the cell is left alone: PolyCE already built it at the target density, and
# the in-plane edges are the substrate's and are not ours to change.
fix             COOL all nvt temp ${T_HIGH} ${T_ROOM} ${TDAMP}
run             ${N_COOL}
unfix           COOL

fix             ROOM all nvt temp ${T_ROOM} ${T_ROOM} ${TDAMP}
run             ${N_ROOM}
unfix           ROOM

write_data      02_polymer_bulk_relaxed.data
# The restart is what phase 2 reads: it carries the styles, the box AND the
# image flags, so nothing has to be restated and nothing can drift.
write_restart   02_polymer_bulk_relaxed.restart
print           "PHASE1_DONE atoms $(count(all)) density $(density)"
jump SELF mode_end

label mode_end
