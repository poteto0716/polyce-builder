# Stage 06 -- the film onto the silica, under load, then cooled. GPU half.
#
# Phase 4 is split in two because exactly one thing in it cannot run on a GPU:
# `compute group/group ... kspace yes`, which LAMMPS refuses against pppm/kk
# ("Kspace style does not support compute group/group"). That compute is the
# adhesion measurement and it is used nowhere else, so the 720,000 steps of MD
# that come before it have no reason to be on a CPU. Measured on 34,332 atoms:
# 56.5 steps/s on one RTX 5070 Ti against 5.2 serial on CPU. Running a
# non-KOKKOS pppm inside a KOKKOS run does restore group/group, but at
# 3.0 steps/s -- the per-step host/device copy costs more than the GPU wins --
# so the measurement stays on the CPU, in in.04b_interface_measure.lmp.
#
# THE LOAD. A film above Tg with vacuum over it expands into the vacuum. With
# no load, this system's 5-95% mass span went 40.6 A leaving phase 2 -- already
# above the 31.7 A its density asks for -- then 100.5 A by step 40000 on the
# substrate at 1000 K and 132.8 A by step 180000. Every one of the fifteen
# molecular centres was still inside the film, so it was foaming, not
# evaporating. `PRESS_MPA` presses it against the surface while it relaxes, and
# comes off before anything is measured.
#
variable data     index 05_interface_merged.data
variable T_HIGH   index 550.0
variable T_ROOM   index 300.0
variable TDAMP    index 100.0
variable DT       index 0.25
variable FIX_THICK index 3.0          # A of substrate held at its base
variable N_WARM   index 40000         # 10 ps ramp into T_HIGH
variable N_HOT    index 400000        # 100 ps at T_HIGH, under load
variable N_COOL   index 800000        # 200 ps T_HIGH -> T_ROOM, under load
variable N_FREE   index 200000        # 50 ps at T_ROOM after the load is gone
variable PRESS_MPA index 0.0          # uniaxial load on the film; 0 = off

units           real
atom_style      full
boundary        p p f
pair_style      lj/class2/coul/long 12.0 12.0
pair_modify     table 0
pair_modify     mix sixthpower
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj 0.0 0.0 1.0 coul 0.0 0.0 1.0
read_data       ${data}

# Rebuild the neighbour list whenever it is needed, not on a schedule. LAMMPS
# defaults to `delay 10`; a melt at temperature moves far enough in ten steps
# that a bonded partner can leave the list, and the run stops with "Bond atoms
# missing". That killed a 60,320-atom relax at step 63168 which had been steady
# in temperature, energy and density throughout.
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# After a merge the substrate is simply the atoms that came first, and how many
# there are is a fact about the two files rather than something to guess:
# tools/interface_merge_params.py reads it off them and passes it in.
variable        n_sub index 2928
group           substrate id 1:${n_sub}
group           polymer subtract all substrate

# Only the base of the substrate is held. The surface the polymer lands on has
# to be free to respond to it.
variable        zFixHi equal bound(substrate,zmin)+${FIX_THICK}
region          R_FIXED block INF INF INF INF INF ${zFixHi} units box
group           in_fixed region R_FIXED
group           frozen intersect substrate in_fixed
group           mobile subtract all frozen
velocity        frozen set 0.0 0.0 0.0
fix             FREEZE frozen setforce 0.0 0.0 0.0

timestep        ${DT}
thermo          5000
thermo_style    custom step temp pe ke etotal
thermo_modify   flush yes

variable        gapnow equal bound(polymer,zmin)-bound(substrate,zmax)
variable        spanpoly equal bound(polymer,zmax)-bound(polymer,zmin)
print           "INITIAL gap $(v_gapnow) A  film span $(v_spanpoly) A"

# A CLOSED system in z. With `boundary p p f` an atom that reaches a box face is
# gone, and its bonded partner then stops the run with "Bond atoms N M missing".
# The faces are tens of angstroms away, so a reflection only ever happens to
# something that has already left; losing the atom instead would be a silent
# change to the composition.
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE

min_style       cg
minimize        1.0e-4 1.0e-6 10000 100000

velocity        mobile create 50.0 4928459 mom yes rot yes dist gaussian
fix             WARM mobile nvt temp 50.0 ${T_HIGH} ${TDAMP}
run             ${N_WARM}
unfix           WARM

# --- the load ----------------------------------------------------------------
# A pressure, converted here rather than passed in as a per-atom force, so that
# one number means one thing for any polymer, any atom count and any substrate
# area:
#
#     F_total[kcal/mol/A] = P[MPa] * A[A^2] * 1.439323e-4
#
# from 1 kcal/mol/A = 6.947695e-11 N and 1 MPa * 1 A^2 = 1e-14 N.
#
# It is a body force on the film, so the stress is PRESS_MPA at the silica
# surface and falls to zero at the free top surface. A uniform stress would
# take a piston, and a piston would have to be made of atoms; what is wanted
# here is the film held down on the surface it is being bonded to, which is
# where this load is strongest.
variable        FZ equal ${PRESS_MPA}*lx*ly*1.439323e-4/count(polymer)
if "${PRESS_MPA} > 0.0" then &
   "fix LOAD polymer addforce 0.0 0.0 -${FZ}" &
   "print 'LOAD ${PRESS_MPA} MPa over $(lx*ly) A^2 = ${FZ} kcal/mol/A per polymer atom'"

fix             HOT mobile nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
dump            DH all custom 20000 interface_hot.lammpstrj id mol type q xu yu zu
dump_modify     DH sort id
run             ${N_HOT}
undump          DH
unfix           HOT
write_data      06_interface_hot.data
print           "AFTER_HOT gap $(v_gapnow) A  film span $(v_spanpoly) A"

# --- cooling, still under load ------------------------------------------------
fix             COOL mobile nvt temp ${T_HIGH} ${T_ROOM} ${TDAMP}
run             ${N_COOL}
unfix           COOL
print           "AFTER_COOL gap $(v_gapnow) A  film span $(v_spanpoly) A"

# --- and free again -----------------------------------------------------------
# The load comes off at room temperature, where the film is a glass and will not
# open back up, and nothing is measured until it has gone. A film held onto a
# surface by a fix is not an adhered film.
if "${PRESS_MPA} > 0.0" then "unfix LOAD"
fix             FREE mobile nvt temp ${T_ROOM} ${T_ROOM} ${TDAMP}
run             ${N_FREE}
unfix           FREE
write_data      08_interface_cooled.data
print           "PHASE4A_DONE gap $(v_gapnow) A  film span $(v_spanpoly) A  atoms $(count(all))"
print           "PHASE4A_DONE cooled and unloaded structure in 08_interface_cooled.data"
