# Stage 03: free-surface relaxation and optional comparison branches.
# Select a section with: lmp -in <this-file> -var MODE <mode>

variable MODE index reference
if "${MODE} == reference" then "jump SELF mode_reference"
if "${MODE} == branch" then "jump SELF mode_branch"
if "${MODE} == pilot" then "jump SELF mode_pilot"
print "invalid MODE ${MODE}"
quit 1

label mode_reference
# Bias-free reference film.  This is the shared starting point for the
# biased and time-matched unbiased continuations.

variable RESTART   index surface_start.restart
variable T_HIGH    index 550.0
variable TDAMP     index 100.0
variable DT_SHAKE  index 1.0
variable N_REF     index 500000

read_restart    ${RESTART}
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE

group           siloxane_si type 8
compute         ZBIN all chunk/atom bin/1d z lower 1.0 units box
fix             DENSITY all ave/chunk 1000 5 5000 ZBIN density/mass file reference_mass_density.dat
fix             SI_DENSITY siloxane_si ave/chunk 1000 5 5000 ZBIN density/number file reference_si_density.dat
dump            TRAJ all custom 5000 reference.lammpstrj id mol type q xu yu zu
dump_modify     TRAJ sort id first yes

timestep        ${DT_SHAKE}
fix             HOT all nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
fix             XH all shake 1.0e-6 200 5000 b 5 12 15
# Define velocities after SHAKE so the requested temperature uses the reduced
# constrained degrees of freedom from the first reported step.
velocity        all create ${T_HIGH} 73191 mom yes rot yes dist gaussian

variable        EXTENT equal bound(all,zmax)-bound(all,zmin)
thermo          5000
thermo_style    custom step time temp pe ke etotal v_EXTENT
thermo_modify   flush yes
run             ${N_REF}

write_data      reference_shake.data
write_restart   reference_shake.restart
print           "REFERENCE_DONE time $(time) fs temp $(temp) K extent $(v_EXTENT) A"
jump SELF mode_end

label mode_branch
# Continue a settled reference film with or without a temporary surface bias.
# The two independently measured surface positions need not be symmetric.

variable RESTART       index reference_shake.restart
variable PREFIX        index biased
variable T_HIGH        index 550.0
variable TDAMP         index 100.0
variable DT_SHAKE      index 1.0
variable DT_RELEASE    index 0.25
variable N_SURFACE     index 500000
variable N_RELEASE     index 20000
variable BIAS_KCAL     index 0.25
variable BIAS_GROUP    index siloxane_si
variable BOTTOM_INNER  index 0.0
variable TOP_INNER     index 1.0
variable SILOXANE_TYPE index 8

read_restart    ${RESTART}
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE

group           siloxane_si type ${SILOXANE_TYPE}
# Types 7/8/9/10 (c2/sio/c3/osi) occur only in the PDMS linker and backbone.
# BIAS_GROUP can be changed to pdms_heavy to distribute the field over the
# complete siloxane segment while the diagnostics remain Si-specific.
group           pdms_heavy type 7 8 9 10

# Smooth double-well field derived from the measured reference-film surfaces.
# The centre is an energy maximum (+D), each inner surface is a minimum (-D),
# and the field is flat farther into the surface tail.  Thus every interior Si
# feels an outward force, unlike a narrow surface-only switch that cannot pull
# a buried PDMS block toward the surface.  The centre-to-surface preference is
# 2*BIAS_KCAL per Si atom.  Energy and force are an exact derivative pair.
variable        bias_mid equal 0.5*(${BOTTOM_INNER}+${TOP_INNER})
variable        bias_half equal 0.5*(${TOP_INNER}-${BOTTOM_INNER})
variable        bias_distance atom abs(z-v_bias_mid)
variable        segregation_energy atom ternary(v_bias_distance<v_bias_half,${BIAS_KCAL}*cos(3.141592653589793*v_bias_distance/v_bias_half),-${BIAS_KCAL})
variable        segregation_force atom (v_bias_distance<v_bias_half)*${BIAS_KCAL}*3.141592653589793/v_bias_half*sin(3.141592653589793*(z-v_bias_mid)/v_bias_half)

variable        si_surface atom (type==${SILOXANE_TYPE})*((z<=${BOTTOM_INNER})+(z>=${TOP_INNER}))
variable        si_interior atom (type==${SILOXANE_TYPE})*(z>${BOTTOM_INNER})*(z<${TOP_INNER})
variable        all_surface atom ((z<=${BOTTOM_INNER})+(z>=${TOP_INNER}))
variable        all_interior atom (z>${BOTTOM_INNER})*(z<${TOP_INNER})
compute         NSIS all reduce sum v_si_surface
compute         NSII all reduce sum v_si_interior
compute         NAS all reduce sum v_all_surface
compute         NAI all reduce sum v_all_interior
variable        SI_SURFACE_FRACTION equal c_NSIS/(c_NSIS+c_NSII)
variable        ENRICHMENT equal (c_NSIS/(c_NAS+1.0e-20))/((c_NSII+1.0e-20)/(c_NAI+1.0e-20))
variable        ZCOM equal xcm(all,z)
variable        EXTENT equal bound(all,zmax)-bound(all,zmin)

compute         ZBIN all chunk/atom bin/1d z lower 1.0 units box
fix             DENSITY all ave/chunk 1000 5 5000 ZBIN density/mass file ${PREFIX}_mass_density.dat
fix             SI_DENSITY siloxane_si ave/chunk 1000 5 5000 ZBIN density/number file ${PREFIX}_si_density.dat
dump            TRAJ all custom 5000 ${PREFIX}.lammpstrj id mol type q xu yu zu
dump_modify     TRAJ sort id first yes

timestep        ${DT_SHAKE}
fix             HOT all nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
if "${BIAS_KCAL} > 0.0" then "fix SEGREGATE ${BIAS_GROUP} addforce 0.0 0.0 v_segregation_force energy v_segregation_energy"
if "${BIAS_KCAL} > 0.0" then "fix_modify SEGREGATE energy yes"
fix             XH all shake 1.0e-6 200 5000 b 5 12 15
# A one-body segregation field can otherwise accelerate the entire free film.
# Remove global translation and keep the film mass centre at the reference
# position.  These fixes intentionally follow the integration fixes, and the
# identical treatment is applied to biased and control branches.
fix             MOMENTUM all momentum 1 linear 1 1 1
fix             RECENTER all recenter NULL NULL INIT shift all units box

thermo          5000
thermo_style    custom step time temp pe ke etotal c_NSIS c_NSII v_SI_SURFACE_FRACTION v_ENRICHMENT v_ZCOM v_EXTENT
thermo_modify   flush yes
run             ${N_SURFACE}

# Preserve the biased morphology before changing the Hamiltonian.
write_data      ${PREFIX}_shake.data
write_restart   ${PREFIX}_shake.restart

if "${BIAS_KCAL} > 0.0" then "unfix SEGREGATE"
unfix           XH
unfix           RECENTER
unfix           MOMENTUM
unfix           HOT
timestep        ${DT_RELEASE}
fix             RELEASE all nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
fix             MOMENTUM all momentum 1 linear 1 1 1
fix             RECENTER all recenter NULL NULL INIT shift all units box
run             ${N_RELEASE}
unfix           RECENTER
unfix           MOMENTUM
unfix           RELEASE

write_data      ${PREFIX}_released.data
write_restart   ${PREFIX}_released.restart
print           "SURFACE_DONE ${PREFIX} bias ${BIAS_KCAL} time $(time) fs Si_surface_fraction $(v_SI_SURFACE_FRACTION) enrichment $(v_ENRICHMENT)"
jump SELF mode_end

label mode_pilot
# One high-temperature free-film branch. BIAS_KCAL=0 is the control; a positive value
# applies the bounded two-surface preference to siloxane Si atoms.  SHAKE and
# the temporary field are both removed before a short unconstrained PCFF-IFF
# hold at 0.25 fs.

variable RESTART       index surface_start.restart
variable PREFIX        index unbiased
variable T_HIGH        index 550.0
variable TDAMP         index 100.0
variable DT_SHAKE      index 1.0
variable DT_RELEASE    index 0.25
variable N_SURFACE     index 200000
variable N_RELEASE     index 20000
variable TARGET        index 34.109072
variable BIAS_KCAL     index 0.0
variable BIAS_WIDTH    index 2.0
variable BIAS_SKIN     index 6.0
variable SILOXANE_TYPE index 8

read_restart    ${RESTART}
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE

group           siloxane_si type ${SILOXANE_TYPE}
variable        mid_now equal xcm(all,z)
variable        edge_now equal 0.5*${TARGET}-${BIAS_SKIN}
variable        BIAS_MID index $(v_mid_now)
variable        BIAS_EDGE index $(v_edge_now)

variable        surface_switch atom 1.0/(1.0+exp(-(abs(z-${BIAS_MID})-${BIAS_EDGE})/${BIAS_WIDTH}))
variable        segregation_energy atom -${BIAS_KCAL}*v_surface_switch
variable        segregation_force atom ${BIAS_KCAL}/${BIAS_WIDTH}*v_surface_switch*(1.0-v_surface_switch)*sign(z-${BIAS_MID})

# Counts and enrichment are evaluated with the same target-thickness surface
# definition used by the bias.  This makes the two trajectories directly
# comparable even while the initially diffuse film is compacting.
variable        si_surface atom (type==${SILOXANE_TYPE})*(abs(z-${BIAS_MID})>=${BIAS_EDGE})
variable        si_interior atom (type==${SILOXANE_TYPE})*(abs(z-${BIAS_MID})<${BIAS_EDGE})
variable        all_surface atom (abs(z-${BIAS_MID})>=${BIAS_EDGE})
variable        all_interior atom (abs(z-${BIAS_MID})<${BIAS_EDGE})
compute         NSIS all reduce sum v_si_surface
compute         NSII all reduce sum v_si_interior
compute         NAS all reduce sum v_all_surface
compute         NAI all reduce sum v_all_interior
variable        SI_SURFACE_FRACTION equal c_NSIS/(c_NSIS+c_NSII)
variable        ENRICHMENT equal (c_NSIS/c_NAS)/(c_NSII/c_NAI)

compute         ZBIN all chunk/atom bin/1d z lower 1.0 units box
fix             DENSITY all ave/chunk 1000 5 5000 ZBIN density/mass file ${PREFIX}_mass_density.dat
fix             SI_DENSITY siloxane_si ave/chunk 1000 5 5000 ZBIN density/number file ${PREFIX}_si_density.dat
dump            TRAJ all custom 5000 ${PREFIX}.lammpstrj id mol type q xu yu zu
dump_modify     TRAJ sort id

velocity        all create ${T_HIGH} 73191 mom yes rot yes dist gaussian
timestep        ${DT_SHAKE}
fix             HOT all nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
if "${BIAS_KCAL} > 0.0" then "fix SEGREGATE siloxane_si addforce 0.0 0.0 v_segregation_force energy v_segregation_energy"
if "${BIAS_KCAL} > 0.0" then "fix_modify SEGREGATE energy yes"
# Define SHAKE after force-changing fixes, as required by fix shake.
fix             XH all shake 1.0e-6 200 5000 b 5 12 15

thermo          5000
thermo_style    custom step time temp pe ke etotal c_NSIS c_NSII v_SI_SURFACE_FRACTION v_ENRICHMENT
thermo_modify   flush yes
run             ${N_SURFACE}

# Restore the ordinary, fully flexible PCFF-IFF Hamiltonian before any future
# interface calculation.  Recreate the thermostat because SHAKE changes the
# number of kinetic degrees of freedom.
if "${BIAS_KCAL} > 0.0" then "unfix SEGREGATE"
unfix           XH
unfix           HOT
timestep        ${DT_RELEASE}
fix             RELEASE all nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
run             ${N_RELEASE}
unfix           RELEASE

write_data      ${PREFIX}_released.data
write_restart   ${PREFIX}_released.restart
print           "SURFACE_BRANCH_DONE ${PREFIX} bias ${BIAS_KCAL} time $(time) fs Si_surface_fraction $(v_SI_SURFACE_FRACTION) enrichment $(v_ENRICHMENT)"
jump SELF mode_end

label mode_end
