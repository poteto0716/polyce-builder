variable SAMPLE_EVERY index 1000
variable PROFILE_REPEAT index 100
variable PROFILE_STEPS index 100000
variable data     index 08_interface_cooled.data
variable T_ROOM   index 300.0
variable TDAMP    index 100.0
variable DT       index 0.25
variable FIX_THICK index 3.0
variable N_ROOM   index 400000
units           real
atom_style      full
boundary        p p f
pair_style      lj/class2/coul/long 12.0 12.0
pair_modify     table 0
pair_modify     mix sixthpower
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj 0.0 0.0 1.0 coul 0.0 0.0 1.0
read_data       ${data}
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
variable        n_sub index 2928
group           substrate id 1:${n_sub}
group           polymer subtract all substrate
variable        zFixHi equal bound(substrate,zmin)+${FIX_THICK}
region          R_FIXED block INF INF INF INF INF ${zFixHi} units box
group           in_fixed region R_FIXED
group           frozen intersect substrate in_fixed
group           mobile subtract all frozen
velocity        frozen set 0.0 0.0 0.0
fix             FREEZE frozen setforce 0.0 0.0 0.0
timestep        ${DT}
thermo          5000
thermo_style    custom step temp pe ke etotal
thermo_modify   flush yes
variable        gapnow equal bound(polymer,zmin)-bound(substrate,zmax)
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE
fix             ROOM mobile nvt temp ${T_ROOM} ${T_ROOM} ${TDAMP}
compute         EINT polymer group/group substrate pair yes kspace yes
compute         CHZ all chunk/atom bin/1d z lower 1.0 units box
fix             PROF all ave/chunk ${SAMPLE_EVERY} ${PROFILE_REPEAT} ${PROFILE_STEPS} CHZ &
                density/mass file density_profile.dat
variable        s equal step
variable        e equal c_EINT
fix             EOUT all print ${SAMPLE_EVERY} "$s $e $(v_gapnow)" file interface_room.dat screen no &
                title "# step E_interface_kcal_mol gap_A"
run             ${N_ROOM}
unfix           EOUT
unfix           PROF
unfix           ROOM
write_data      09_interface_final.data
run             0
print           "PHASE4B_DONE atoms $(count(all)) gap $(v_gapnow) Eint $(c_EINT)"
print           "PHASE4B_DONE the interface energy series is in interface_room.dat"
