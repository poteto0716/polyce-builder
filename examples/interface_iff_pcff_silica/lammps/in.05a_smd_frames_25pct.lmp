# Prepare canonical starting frames for SMD pulling of the upper 25% of the
# polymer thickness.  Grip membership is defined once and is stored in every
# restart, so the reaction coordinate is identical across replicas.

variable data        index 09_interface_final.data
variable n_sub       index 11712
variable T           index 300.0
variable TDAMP       index 100.0
variable DT          index 1.0
variable K           index 100.0
variable SEED        index 73129
variable N_EQUIL     index 100000
variable N_SPACING   index 100000
variable N_FRAMES    index 10
variable SUB_XH      index 3
variable POLY_XH1    index 8
variable POLY_XH2    index 15
variable POLY_XH3    index 18
variable FIX_THICK   index 3.0
variable SURFACE_ZLO index 0.0
variable SURFACE_ZHI index 1.0
variable Z_GRIP_MIN  index 0.75

units           real
atom_style      full
boundary        p p f
pair_style      lj/class2/coul/long 12.0 12.0
pair_modify     table 0
pair_modify     mix sixthpower
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj 0.0 0.0 1.0 coul 0.0 0.0 1.0
read_data       ${data}

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

group           substrate id 1:${n_sub}
group           polymer subtract all substrate
variable        zFixHi equal bound(substrate,zmin)+${FIX_THICK}
region          R_FIXED block INF INF INF INF INF ${zFixHi} units box
group           in_fixed region R_FIXED
group           frozen intersect substrate in_fixed
group           mobile subtract all frozen
velocity        frozen set 0.0 0.0 0.0
fix             FREEZE frozen setforce 0.0 0.0 0.0
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE

# Geometrical upper quarter of the robust 5--95 mass-percent film envelope.
# The dilute coordinate tails are excluded when defining its thickness but all
# atoms above the resulting threshold belong to the grip.  Region groups are
# evaluated when this command is issued; `grip` is not dynamic.
variable        zPolyMin equal bound(polymer,zmin)
variable        zPolyMax equal bound(polymer,zmax)
region          R_GRIP block INF INF INF INF ${Z_GRIP_MIN} INF units box
group           in_grip region R_GRIP
group           grip intersect polymer in_grip
variable        Ngrip equal count(grip)
variable        Npolymer equal count(polymer)
variable        gripFraction equal v_Ngrip/v_Npolymer
variable        Mgrip equal mass(grip)
variable        z0 equal $(xcm(grip,z))

if "${Ngrip} < 1" then "print 'empty SMD grip'" "quit 1"

# Equilibrate with the same stationary collective-coordinate spring used at
# the start of the pull.  For a COM spring, the force must be distributed in
# proportion to atom mass; equal per-atom forces are not its gradient.
variable        zcm equal xcm(grip,z)
variable        fspr equal v_K*(v_z0-v_zcm)
variable        fatom atom v_fspr*mass/v_Mgrip
variable        uspr atom 0.5*v_K*(v_z0-v_zcm)^2*mass/v_Mgrip
fix             HOLD grip addforce 0.0 0.0 v_fatom energy v_uspr
fix_modify      HOLD energy yes

timestep        ${DT}
fix             XH all shake 1.0e-6 200 5000 b ${SUB_XH} ${POLY_XH1} ${POLY_XH2} ${POLY_XH3}
velocity        mobile create ${T} ${SEED} mom yes rot yes dist gaussian
fix             NVT mobile nvt temp ${T} ${T} ${TDAMP}
thermo          5000
thermo_style    custom step time temp pe ke etotal v_zcm v_fspr
thermo_modify   flush yes

print "grip_definition upper_25pct_of_5_95_mass_envelope surface_zlo_A ${SURFACE_ZLO} surface_zhi_A ${SURFACE_ZHI} z_poly_min_A ${zPolyMin} z_poly_max_A ${zPolyMax} z_grip_min_A ${Z_GRIP_MIN} z_tether0_A ${z0} n_grip ${Ngrip} n_polymer ${Npolymer} grip_atom_fraction ${gripFraction}" file grip_metadata.txt screen yes

# First allow the newly applied stationary spring and reassigned velocities to
# equilibrate.  Then make N_FRAMES starts separated by N_SPACING timesteps.
run             ${N_EQUIL}
reset_timestep  0
write_restart   frame_0.restart
variable        N_MORE equal (${N_FRAMES}-1)*${N_SPACING}
if "${N_FRAMES} > 1" then "restart ${N_SPACING} frame_*.restart" "run ${N_MORE}"

print "SMD_FRAMES_DONE replicas ${N_FRAMES} spacing_steps ${N_SPACING}"
