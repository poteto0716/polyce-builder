# Stage 02: free-surface creation or combined generic slab relaxation.
# Select a section with: lmp -in <this-file> -var MODE <mode>

variable MODE index create
if "${MODE} == create" then "jump SELF mode_create"
if "${MODE} == relax" then "jump SELF mode_relax"
print "invalid MODE ${MODE}"
quit 1

label mode_create
# Stage 02: create a common free-surface starting state from periodic bulk.
# Both the unbiased and biased branches read the restart written here, so they
# start from identical coordinates, velocities, box, and image flags.

variable RESTART index bulk_shake.restart
variable VAC     index 68.2

read_restart    ${RESTART}
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
kspace_style    pppm 1.0e-5

compute         XU all property/atom xu yu zu
compute         IZ all property/atom iz
compute         ZMIN all reduce min c_XU[3]
compute         ZMAX all reduce max c_XU[3]
thermo_style    custom step pe c_ZMIN c_ZMAX
run             0

variable        zlo_u equal $(c_ZMIN)
variable        zhi_u equal $(c_ZMAX)
variable        Lz0 equal $(lz)
variable        dz atom c_IZ*${Lz0}

change_box      all z final $(v_zlo_u-v_VAC) $(v_zhi_u+v_VAC) units box
displace_atoms  all move 0.0 0.0 v_dz units box
set             group all image NULL NULL 0
change_box      all boundary p p f
kspace_modify   slab 3.0

fix             REFLECT all wall/reflect zlo EDGE zhi EDGE
thermo          500
thermo_style    custom step pe etotal

# Keep the free-film relaxation visible.  A frame every 10 minimizer
# iterations gives about a dozen frames for the present production structure
# without producing a needlessly large trajectory.  Unwrapped coordinates
# preserve whole-chain motion across the periodic x/y boundaries in OVITO.
dump            RELAX all custom 10 surface_start_relax.lammpstrj &
                id mol type q xu yu zu
dump_modify     RELAX sort id first yes
min_style       cg
minimize        1.0e-4 1.0e-6 10000 100000
undump          RELAX

# The same Maxwell distribution is regenerated in each branch, ensuring that
# branch differences arise from the temporary segregation field.
velocity        all set 0.0 0.0 0.0
write_data      surface_start.data
write_restart   surface_start.restart
print           "SURFACE_START_DONE atoms $(count(all)) z $(bound(all,zmin)) .. $(bound(all,zmax))"
jump SELF mode_end

label mode_relax
# Phase 2 -- make every molecule whole, THEN remove the z periodicity.
#
# THE ORDER IS THE WHOLE POINT, and there are two orderings to get right.
#
# 1. Unwrap before freeing z. A chain crossing the z face is stored as two
#    pieces plus a flag saying they are one. Free z first and that flag stops
#    meaning anything: two pieces most of a box apart, joined by a bond LAMMPS
#    will try to evaluate across the cell.
#
# 2. Grow the box before displacing. `displace_atoms` remaps into the periodic
#    box, so displacing first simply puts every atom back where it started with
#    its image flag bumped -- measured, on a two-atom fixture. And because an
#    image flag means "this many CURRENT box lengths", the displacement has to
#    be computed from the ORIGINAL Lz, captured as a number before the box
#    changes.
#
# `reset_atoms image` is not what makes this work and is not used: it reasons
# from flags that are already there. PolyCE computes them from the bond graph at
# write time (`polyce/system/ImageFlags.hpp`), which is the only point at which
# the unwrapped relationship is known for certain.
#
#   lmp -in in.02_polymer_slab.lmp
#
variable restart index 02_polymer_bulk_relaxed.restart
variable T_ROOM  index 300.0
# ABOVE Tg, and that is the whole reason this stage works. PMMA's Tg is near
# 378 K; settling a half-density slab at 300 K leaves the chains glassy and
# unable to move, so the loose material only spreads. Measured: 5 ps at 300 K
# took the film from 68.84 A to 84.79 A -- it got THICKER, which is the opposite
# of settling. Above Tg it collapses under its own cohesion, and it is then
# cooled back with the film already compact.
variable T_HIGH  index 550.0
variable TDAMP   index 100.0
variable DT      index 0.25
variable VAC     index 60.0          # A of vacuum above and below the film
variable N_SETTLE index 200000       # steps for the compaction stage
# The thickness the film's own mass demands: mass / (density * Lx * Ly). The
# caller computes it, because PolyCE knows the mass and the target density and
# this script knows neither.
variable TARGET  index 34.246
variable N_ANNEAL index 400000       # after the walls come off: heal, and hold

# Optional accelerated surface-segregation field.  It is off by default, and
# the generic workflow therefore remains bit-for-bit the old protocol unless
# the caller explicitly supplies a positive SEGREGATION_KCAL.  The field acts
# only on siloxane Si atoms during N_ANNEAL and is removed before cooling and
# before this film ever sees a substrate.
#
# SEGREGATION_KCAL is the bounded bulk-to-surface energy decrease PER Si atom;
# it is not a physical force-field parameter.  SEGREGATION_SKIN places the
# midpoint of the smooth step this far inside each target film surface, and
# SEGREGATION_WIDTH controls its transition width.  SILOXANE_TYPE is discovered
# from PolyCE's `# sio` Masses comment by interface_workflow.sh, never guessed.
variable SEGREGATION_KCAL index 0.0   # kcal/mol per siloxane Si; 0 = disabled
variable SEGREGATION_WIDTH index 2.0  # A, logistic transition width
variable SEGREGATION_SKIN index 6.0   # A, surface-favoured skin
variable SILOXANE_TYPE index 1        # ignored while the field is disabled

# A restart carries the styles, the box and the image flags -- everything phase 2
# needs -- but NOT the k-space solver. A class2 coul/long pair without one stops
# with "Pair style requires a KSpace style" on the very first `run 0` below
# (D037), so it is set again immediately. While the cell is still fully periodic:
# the slab correction is added after z is freed, because there is no slab yet.
read_restart    ${restart}

# Rebuild the neighbour list whenever it is needed, not on a schedule. LAMMPS
# defaults to `delay 10`; a melt at 550 K moves far enough in ten steps that a
# bonded partner can leave the list, and the run stops with "Bond atoms
# missing". That killed a 60,320-atom relax at step 63168 which had been steady
# in temperature, energy and density throughout. The smoke system was too small
# to reach it.
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
kspace_style    pppm 1.0e-5

compute         XU all property/atom xu yu zu
compute         IZ all property/atom iz
compute         ZMIN all reduce min c_XU[3]
compute         ZMAX all reduce max c_XU[3]
thermo_style    custom step c_ZMIN c_ZMAX
run             0

# Captured as literals, because everything below changes the box they came from.
variable        zlo_u equal $(c_ZMIN)
variable        zhi_u equal $(c_ZMAX)
variable        Lz0   equal $(lz)
print           "UNWRAPPED extent ${zlo_u} .. ${zhi_u}  (box Lz was ${Lz0})"

# --- 1. a box the unwrapped molecules fit inside ------------------------------
variable        dz atom c_IZ*${Lz0}
change_box      all z final $(v_zlo_u-v_VAC) $(v_zhi_u+v_VAC) units box

# --- 2. unwrap: every atom to its own unwrapped z, flags then cleared ---------
displace_atoms  all move 0.0 0.0 v_dz units box
set             group all image NULL NULL 0

# --- 3. and only now, a free z ------------------------------------------------
change_box      all boundary p p f
kspace_modify   slab 3.0

# `$(pe)` needs the thermo to have been initialised WITH potential energy, and
# the style above is `step c_ZMIN c_ZMAX`, which has none. LAMMPS says so --
# "Thermo keyword pe in variable requires thermo to use/init potential energy"
# -- and the fix is to ask for it before asking for it.
thermo_style    custom step pe
run             0
print           "SLAB_READY atoms $(count(all)) z $(bound(all,zmin)) .. $(bound(all,zmax)) pe $(pe)"

# The two new free surfaces were bulk a moment ago; they have to become
# surfaces.
timestep        ${DT}
thermo          5000
thermo_style    custom step temp pe ke etotal
thermo_modify   flush yes

# A CLOSED system in z. With `boundary p p f` an atom that reaches a box face is
# gone, and its bonded partner then stops the run with "Bond atoms N M missing".
# That is exactly what a half-density film above Tg does: measured here, the
# smoke slab lost an atom at step 24423 while settling at 550 K, because chain
# ends evaporate off a loose free surface into 60 A of vacuum.
#
# Reflecting the box faces makes the system closed, which is what building a
# film means -- the material is the material. It is not a constraint on the
# film: the faces are tens of angstroms away and a reflection only ever happens
# to something that has already left. Losing atoms instead would be a silent
# change to the composition, and `lost warn` would make it silent AND legal.
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE

min_style       cg
minimize        1.0e-4 1.0e-6 10000 100000
velocity        all create 50.0 90210 mom yes rot yes dist gaussian
fix             WARM all nvt temp 50.0 ${T_HIGH} ${TDAMP}
run             $(v_N_SETTLE/10)
unfix           WARM
# --- let it become a film ---------------------------------------------------
# No squeezing walls. Unwrapping moves material out of the cell into what was
# vacuum, so the slab starts thick and thin -- roughly twice the occupied z and
# about half the melt density. A polymer melt above Tg closes that on its own:
# it has a surface tension and nothing holding it open.
#
# Driving it with moving walls was worse than doing nothing. `wall/reflect`
# reverses the normal velocity of whatever it touches, so walls closing faster
# than the melt can follow hammer the film instead of compacting it. Measured
# on the smoke system: a 70.1 A film "squeezed" towards 34.2 A came out 145.7 A
# thick, in TWO lobes with vacuum between them, because the walls drove the
# halves apart and were then removed.
#
# What is kept is `wall/reflect` at the BOX FACES, fixed and far away. Those are
# not shaping anything -- they only stop a chain end that has evaporated off the
# free surface from being lost, which with `boundary p p f` ends the run with
# "Bond atoms missing".
# Above Tg for the whole of it. PMMA's Tg is near 378 K, and a slab held below
# it is glassy: the chains cannot move, so the loose material never closes and
# the run only spreads. The earlier version created this thermostat and the
# removal of the squeeze took it with it -- the film then sat at 89 K and its
# thickness did not change at all, 70.31 A after "settling" from 70.12 A.
velocity        all create ${T_HIGH} 90210 mom yes rot yes dist gaussian
fix             HOT all nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
run             ${N_SETTLE}
print           "AFTER_SETTLE thickness $(bound(all,zmax)-bound(all,zmin)) A"

# --- optional accelerated siloxane surface segregation ----------------------
#
# The bounded potential is symmetric about the film centre:
#
#   U_i(z) = -DeltaU / (1 + exp(-(abs(z-zmid)-zedge)/width))
#
# It is approximately zero in the interior and -DeltaU in either surface skin.
# The force below is exactly -dU/dz (apart from the immaterial cusp at zmid,
# where the logistic derivative is already exponentially small).  A bounded
# chemical-potential difference is used instead of a constant outward force so
# a Si atom gains no further reward by leaving the film.  Applying it to one Si
# per siloxane repeat also avoids multiplying the bias by every methyl H atom.
#
# This is accelerated preparation, not equilibrium dynamics.  The field is
# removed before cooling; all interface relaxation and adhesion measurements
# use the unmodified PCFF-IFF Hamiltonian.
variable        bias_mid_now equal xcm(all,z)
variable        bias_edge_now equal 0.5*${TARGET}-${SEGREGATION_SKIN}
variable        BIAS_MID index $(v_bias_mid_now)
variable        BIAS_EDGE index $(v_bias_edge_now)
variable        surface_switch atom 1.0/(1.0+exp(-(abs(z-${BIAS_MID})-${BIAS_EDGE})/${SEGREGATION_WIDTH}))
variable        segregation_energy atom -${SEGREGATION_KCAL}*v_surface_switch
variable        segregation_force atom ${SEGREGATION_KCAL}/${SEGREGATION_WIDTH}*v_surface_switch*(1.0-v_surface_switch)*sign(z-${BIAS_MID})
if "${SEGREGATION_KCAL} > 0.0" then "group siloxane_si type ${SILOXANE_TYPE}"
if "${SEGREGATION_KCAL} > 0.0" then "fix SEGREGATE siloxane_si addforce 0.0 0.0 v_segregation_force energy v_segregation_energy"
if "${SEGREGATION_KCAL} > 0.0" then "fix_modify SEGREGATE energy yes"
if "${SEGREGATION_KCAL} > 0.0" then "print 'SEGREGATION_BIAS type ${SILOXANE_TYPE} count $(count(siloxane_si)) DeltaU ${SEGREGATION_KCAL} kcal/mol-Si width ${SEGREGATION_WIDTH} A skin ${SEGREGATION_SKIN} A centre ${BIAS_MID} A'"

# Released, and left to hold its own shape AND to heal. Squeezing two lobes
# together does not merge them: measured, a 2.5 ps release left a 0.28 g/cm^3
# void between two 0.9 g/cm^3 halves. Closing that needs chain motion across it,
# which is a time, not a force -- so `N_ANNEAL` is separate from `N_SETTLE` and
# is the number to raise when the profile still shows a dip.
#
# A film that springs back was not a film, and this is also where that shows.
run             ${N_ANNEAL}
if "${SEGREGATION_KCAL} > 0.0" then "unfix SEGREGATE"
if "${SEGREGATION_KCAL} > 0.0" then "print 'SEGREGATION_BIAS removed; subsequent cooling and interface stages are unbiased'"
unfix           HOT

fix             COOLS all nvt temp ${T_HIGH} ${T_ROOM} ${TDAMP}
run             $(v_N_SETTLE/2)
unfix           COOLS

# THE DENSITY PROFILE IS THE CHECK, not the z extent. Unwrapping makes every
# molecule whole by putting it in ONE image, and molecules that straddled the
# face end up on opposite sides -- so the material spreads over roughly twice
# the z it occupied, and the slab STARTS at about half the melt's density.
# Measured on the smoke system: 1.1800 g/cm^3 over 34.246 A becomes 0.5892 over
# 68.586 A.
#
# That is expected and it is what `N_SETTLE` is for: the film has to collapse
# back under its own cohesion. A profile with a flat interior at the melt
# density and two surfaces is a film; one that is still a broad hump has not
# settled long enough, and shortening this run is how a half-density slab gets
# merged onto a substrate without anyone noticing.
compute         CHZ all chunk/atom bin/1d z lower 1.0 units box
fix             PROF all ave/chunk 1000 10 10000 CHZ density/mass &
                file polymer_slab_density.dat
run             10000
unfix           PROF

write_data      04_polymer_slab.data
print           "PHASE2_DONE atoms $(count(all)) film_z $(bound(all,zmin)) .. $(bound(all,zmax))"
print           "PHASE2_DONE the density profile is in polymer_slab_density.dat -- a film has a "
print           "PHASE2_DONE flat interior at the melt density, not a broad hump"
jump SELF mode_end

label mode_end
