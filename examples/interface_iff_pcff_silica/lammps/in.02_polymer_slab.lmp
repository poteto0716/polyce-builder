variable PROFILE_EVERY index 1000
variable PROFILE_REPEAT index 10
variable PROFILE_STEPS index 10000
variable MIN_ITER index 10000
variable MIN_EVAL index 100000
variable restart index 02_polymer_bulk_relaxed.restart
variable T_ROOM  index 300.0
variable T_HIGH  index 550.0
variable TDAMP   index 100.0
variable DT      index 0.25
variable VAC     index 60.0
variable N_SETTLE index 200000
variable TARGET  index 34.246
variable N_ANNEAL index 400000
read_restart    ${restart}
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
kspace_style    pppm 1.0e-5
compute         XU all property/atom xu yu zu
compute         IZ all property/atom iz
compute         ZMIN all reduce min c_XU[3]
compute         ZMAX all reduce max c_XU[3]
thermo_style    custom step c_ZMIN c_ZMAX
run             0
variable        zlo_u equal $(c_ZMIN)
variable        zhi_u equal $(c_ZMAX)
variable        Lz0   equal $(lz)
print           "UNWRAPPED extent ${zlo_u} .. ${zhi_u}  (box Lz was ${Lz0})"
variable        dz atom c_IZ*${Lz0}
change_box      all z final $(v_zlo_u-v_VAC) $(v_zhi_u+v_VAC) units box
displace_atoms  all move 0.0 0.0 v_dz units box
set             group all image NULL NULL 0
change_box      all boundary p p f
kspace_modify   slab 3.0
thermo_style    custom step pe
run             0
print           "SLAB_READY atoms $(count(all)) z $(bound(all,zmin)) .. $(bound(all,zmax)) pe $(pe)"
timestep        ${DT}
thermo          5000
thermo_style    custom step temp pe ke etotal
thermo_modify   flush yes
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE
min_style       cg
minimize        1.0e-4 1.0e-6 ${MIN_ITER} ${MIN_EVAL}
velocity        all create 50.0 90210 mom yes rot yes dist gaussian
fix             WARM all nvt temp 50.0 ${T_HIGH} ${TDAMP}
run             $(v_N_SETTLE/10)
unfix           WARM
velocity        all create ${T_HIGH} 90210 mom yes rot yes dist gaussian
fix             HOT all nvt temp ${T_HIGH} ${T_HIGH} ${TDAMP}
run             ${N_SETTLE}
print           "AFTER_SETTLE thickness $(bound(all,zmax)-bound(all,zmin)) A"
run             ${N_ANNEAL}
unfix           HOT
fix             COOLS all nvt temp ${T_HIGH} ${T_ROOM} ${TDAMP}
run             $(v_N_SETTLE/2)
unfix           COOLS
compute         CHZ all chunk/atom bin/1d z lower 1.0 units box
fix             PROF all ave/chunk ${PROFILE_EVERY} ${PROFILE_REPEAT} ${PROFILE_STEPS} CHZ density/mass &
                file polymer_slab_density.dat
run             ${PROFILE_STEPS}
unfix           PROF
write_data      04_polymer_slab.data
print           "PHASE2_DONE atoms $(count(all)) film_z $(bound(all,zmin)) .. $(bound(all,zmax))"
print           "PHASE2_DONE the density profile is in polymer_slab_density.dat -- a film has a "
print           "PHASE2_DONE flat interior at the melt density, not a broad hump"
