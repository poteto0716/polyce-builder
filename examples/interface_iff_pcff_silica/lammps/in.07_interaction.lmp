# Stage 07: room-temperature sampling and interaction-energy evaluation.
# Select a section with: lmp -in <this-file> -var MODE <mode>

variable MODE index sample
if "${MODE} == sample" then "jump SELF mode_sample"
if "${MODE} == rerun" then "jump SELF mode_rerun"
if "${MODE} == direct" then "jump SELF mode_direct"
print "invalid MODE ${MODE}"
quit 1

label mode_sample
# Phase 4b -- room-temperature interface trajectory, without the expensive
# group/group K-space decomposition.  This half runs on the GPU.  Phase 4c
# reruns only the saved frames on the CPU and evaluates the interaction energy.

variable data      index 08_interface_cooled.data
variable T_ROOM    index 300.0
variable TDAMP     index 100.0
variable DT        index 0.25
variable FIX_THICK index 3.0
variable N_ROOM    index 400000
variable SAMPLE    index 5000
variable n_sub     index 2928

units           real
atom_style      full
boundary        p p f
pair_style      lj/class2/coul/long 12.0 12.0
pair_modify     table 0
pair_modify     mix sixthpower
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj 0.0 0.0 1.0 coul 0.0 0.0 1.0
read_data       ${data}

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

group           substrate id 1:${n_sub}
group           polymer subtract all substrate
variable        zFixHi equal bound(substrate,zmin)+${FIX_THICK}
region          R_FIXED block INF INF INF INF INF ${zFixHi} units box
group           in_fixed region R_FIXED
group           frozen intersect substrate in_fixed
group           mobile subtract all frozen
velocity        frozen set 0.0 0.0 0.0
fix             FREEZE frozen setforce 0.0 0.0 0.0

timestep        ${DT}
thermo          5000
thermo_style    custom step temp pe ke etotal
thermo_modify   flush yes
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE
fix             ROOM mobile nvt temp ${T_ROOM} ${T_ROOM} ${TDAMP}

# Wrapped x/y/z plus the box are sufficient for rerun: the data file read by
# phase 4c supplies charges, molecule ids and all bonded topology.  `first yes`
# includes the common starting structure and gives the two branches an exactly
# matching first measurement.
dump            ROOM_TRAJ all custom ${SAMPLE} interface_room.lammpstrj id type x y z
dump_modify     ROOM_TRAJ sort id first yes format line "%d %d %.16g %.16g %.16g"
compute         CHZ all chunk/atom bin/1d z lower 1.0 units box
fix             PROF all ave/chunk 1000 100 100000 CHZ density/mass file density_profile.dat

run             ${N_ROOM}

unfix           PROF
undump          ROOM_TRAJ
unfix           ROOM
write_data      09_interface_final.data
print           "PHASE4B_DONE GPU room trajectory in interface_room.lammpstrj, atoms $(count(all))"
jump SELF mode_end

label mode_rerun
# Phase 4c -- interaction energy on saved room-temperature frames.  Ordinary
# CPU PPPM is required because pppm/kk cannot evaluate compute group/group with
# K-space.  Rerunning ~80 frames avoids integrating 400000 CPU timesteps merely
# to sample this quantity.

variable data  index 08_interface_cooled.data
variable traj  index interface_room.lammpstrj
variable n_sub index 2928

units           real
atom_style      full
boundary        p p f
pair_style      lj/class2/coul/long 12.0 12.0
pair_modify     table 0
pair_modify     mix sixthpower
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj 0.0 0.0 1.0 coul 0.0 0.0 1.0
read_data       ${data}

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
group           substrate id 1:${n_sub}
group           polymer subtract all substrate

# Keeping pair and reciprocal terms separate makes a change in adhesion
# interpretable.  LAMMPS documents that the two computes cost no more than one
# combined group/group call because the pair and K-space work are distinct.
compute         EPAIR polymer group/group substrate pair yes kspace no
compute         EKSPACE polymer group/group substrate pair no kspace yes
variable        ETOTAL equal c_EPAIR+c_EKSPACE
variable        GAP equal bound(polymer,zmin)-bound(substrate,zmax)
variable        s equal step
variable        ep equal c_EPAIR
variable        ek equal c_EKSPACE
variable        et equal v_ETOTAL
fix             EOUT all print 1 "${s} ${ep} ${ek} ${et} $(v_GAP)" file interface_room.dat screen no &
                title "# step E_pair_kcal_mol E_kspace_kcal_mol E_interface_kcal_mol gap_A"
thermo          1
thermo_style    custom step pe c_EPAIR c_EKSPACE v_ETOTAL v_GAP

rerun           ${traj} dump x y z box yes
print           "PHASE4C_DONE interaction-energy series in interface_room.dat"
jump SELF mode_end

label mode_direct
# Phase 4b -- what the interface is worth at room temperature. CPU half.
#
# Reads the cooled, UNLOADED structure from 04a and does nothing to it but hold
# it at T_ROOM and record the polymer-substrate interaction energy. It is on
# the CPU because `compute group/group ... kspace yes` needs a kspace style
# that implements it, which rules out pppm/kk and so rules out KOKKOS. It is
# 200,000 of the 920,000 steps; see in.06_interface_relax.lmp MODE=legacy for the
# measurements behind the split.
#
variable data     index 08_interface_cooled.data
variable T_ROOM   index 300.0
variable TDAMP    index 100.0
variable DT       index 0.25
variable FIX_THICK index 3.0
variable N_ROOM   index 400000        # 100 ps at T_ROOM

units           real
atom_style      full
boundary        p p f
pair_style      lj/class2/coul/long 12.0 12.0
pair_modify     table 0
pair_modify     mix sixthpower
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj 0.0 0.0 1.0 coul 0.0 0.0 1.0
read_data       ${data}

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

variable        n_sub index 2928
group           substrate id 1:${n_sub}
group           polymer subtract all substrate

variable        zFixHi equal bound(substrate,zmin)+${FIX_THICK}
region          R_FIXED block INF INF INF INF INF ${zFixHi} units box
group           in_fixed region R_FIXED
group           frozen intersect substrate in_fixed
group           mobile subtract all frozen
velocity        frozen set 0.0 0.0 0.0
fix             FREEZE frozen setforce 0.0 0.0 0.0

timestep        ${DT}
thermo          5000
thermo_style    custom step temp pe ke etotal
thermo_modify   flush yes

variable        gapnow equal bound(polymer,zmin)-bound(substrate,zmax)
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE
fix             ROOM mobile nvt temp ${T_ROOM} ${T_ROOM} ${TDAMP}

# What the interface actually looks like at room temperature.
compute         EINT polymer group/group substrate pair yes kspace yes
# `fix ave/chunk` takes the ID of a `compute chunk/atom`, not inline bin bounds
# -- that spelling belonged to `fix ave/spatial`, which LAMMPS removed.
compute         CHZ all chunk/atom bin/1d z lower 1.0 units box
fix             PROF all ave/chunk 1000 100 100000 CHZ &
                density/mass file density_profile.dat
variable        s equal step
variable        e equal c_EINT
fix             EOUT all print 1000 "$s $e $(v_gapnow)" file interface_room.dat screen no &
                title "# step E_interface_kcal_mol gap_A"
run             ${N_ROOM}
unfix           EOUT
unfix           PROF
unfix           ROOM

write_data      09_interface_final.data

# A `run 0` before the summary, and it is not decoration. Evaluating `$(c_EINT)`
# cold -- after the fixes are removed and a `write_data` has run -- returned
# -2832238 where the recorded series says -25.2: a `compute group/group`
# invoked outside a timestep gives a number that looks like an energy and is
# not one. The series in interface_room.dat is the record; this line only has
# to agree with it.
run             0
print           "PHASE4B_DONE atoms $(count(all)) gap $(v_gapnow) Eint $(c_EINT)"
print           "PHASE4B_DONE the interface energy series is in interface_room.dat"
jump SELF mode_end

label mode_end
