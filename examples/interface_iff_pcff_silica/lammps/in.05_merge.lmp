# Stage 05: stack the polymer slab on the substrate and join the two systems.
#
# The two halves were built by separate PolyCE projects and have independent
# type numbering, so the second file is read with an OFFSET. The numbers come
# from `merge_metadata.json`, which is generated by `tools/merge_metadata.py`
# from what PolyCE actually wrote -- reading them off a data file by eye is how
# a merge ends up with a silicon typed as a carbonyl carbon.
#
# **Cross interactions need nothing.** PCFF-INTERFACE v1.5 declares
# `@combination sixth-power` and contains no `#nonbond_cross` section, and both
# data files carry `Pair Coeffs` in i-i form, so LAMMPS generates every i-j term
# -- including every polymer/silica pair -- by mixing. Verified: merging gives
# the same coefficient table as building the combined system directly.
#
# `extra/*/per/atom` is not optional. The substrate is read first and its atoms
# carry far fewer dihedrals than a PMMA backbone atom does; without headroom
# LAMMPS stops with "Subsequent read data induced too many dihedrals per atom".
#
#   lmp -in in.05_merge.lmp -var gap 3.0
#
variable sub      index ../substrate_slab/output/substrate.data
variable poly     index 04_polymer_slab.data
variable gap      index 3.0           # A between the silica surface and the film
variable vac      index 60.0          # A of vacuum above the film

# Offsets are the SUBSTRATE's type counts, and the extras are the POLYMER's:
# `read_data` has to be told how much room to leave before the second file
# arrives. Both come from `merge_metadata.json` rather than from reading a data
# file by eye, which is how a silicon ends up typed as a carbonyl carbon.
variable off_a    index 4
variable off_b    index 3
variable off_ang  index 5
variable off_d    index 4
variable off_i    index 3
# How much room the merged system needs PER ATOM. These belong to the specific
# pair of files being merged, not to this input: too small an
# `extra/special/per/atom` stops the run, and an offset that is too small maps
# two different types onto one number and writes a structure that reads back
# cleanly and is not the one that was built. tools/interface_merge_params.py
# reads all of them off the two data files; the defaults here are only so the
# input runs alone.
variable xs       index 16
variable xb       index 6
variable xang     index 20
variable xd       index 40
variable xi       index 20
variable add_a    index 7
variable add_b    index 9
variable add_ang  index 18
variable add_d    index 21
variable add_i    index 14

units           real
atom_style      full
boundary        p p f
pair_style      lj/class2/coul/long 12.0 12.0
pair_modify     table 0
pair_modify     mix sixthpower
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj 0.0 0.0 1.0 coul 0.0 0.0 1.0

read_data       ${sub}                                                        &
                extra/atom/types ${add_a} extra/bond/types ${add_b}           &
                extra/angle/types ${add_ang}                                  &
                extra/dihedral/types ${add_d} extra/improper/types ${add_i}   &
                extra/special/per/atom ${xs} extra/bond/per/atom ${xb}        &
                extra/angle/per/atom ${xang} extra/dihedral/per/atom ${xd}    &
                extra/improper/per/atom ${xi}

# Everything read so far IS the substrate, so its group is the ids that exist
# at this moment. `group ... all` is not a thing; this is.
variable        n_sub equal $(count(all))
group           substrate id 1:${n_sub}
variable        sub_top equal bound(substrate,zmax)

# The box has to be tall enough for silica + gap + film + vacuum before the film
# arrives, because `read_data ... add` will not grow it.
change_box      all z final -5.0 400.0 units box

# `read_data ... shift` translates by an ABSOLUTE amount, and the polymer slab's
# own zmin is not zero -- so a shift of `sub_top + gap` does not produce a gap of
# `gap`. Measured: it came out at 5.738 A for a requested 3.0. The file is
# therefore placed roughly and then corrected exactly, once its own extent is
# known.
variable        shift_z equal ${sub_top}+${gap}
print           "MERGE substrate top $(v_sub_top)  first shift $(v_shift_z)"

read_data       ${poly} add append offset ${off_a} ${off_b} ${off_ang} ${off_d} ${off_i} &
                shift 0.0 0.0 ${shift_z}

# Rebuild the neighbour list whenever it is needed, not on a schedule. LAMMPS
# defaults to `delay 10`; a melt at 550 K moves far enough in ten steps that a
# bonded partner can leave the list, and the run stops with "Bond atoms
# missing". That killed a 60,320-atom relax at step 63168 which had been steady
# in temperature, energy and density throughout. The smoke system was too small
# to reach it.
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes


group           polymer subtract all substrate
variable        gap_now equal bound(polymer,zmin)-bound(substrate,zmax)
run             0
variable        dz_fix equal ${gap}-$(v_gap_now)
print           "MERGE gap after the read $(v_gap_now), correcting by ${dz_fix}"
displace_atoms  polymer move 0.0 0.0 ${dz_fix} units box

variable        poly_lo equal bound(polymer,zmin)
variable        poly_hi equal bound(polymer,zmax)
change_box      all z final -5.0 $(v_poly_hi+v_vac) units box

# --- the check that the stack is a stack and not an interpenetration ---------
# A merge that put atoms on top of each other would minimise to a NaN and be
# discovered much later, so it is checked here before anything is integrated.
#
# The gap IS a lower bound on every polymer/substrate separation, and that is a
# property of how the shift was built rather than a measurement: the polymer was
# translated so its lowest atom sits `gap` above the substrate's HIGHEST atom,
# so every substrate atom is at least `gap` below every polymer atom in z alone.
# A finite potential energy is the second half of the check -- overlapping atoms
# in a 9-6 potential do not give one.
variable        gap0 equal bound(polymer,zmin)-bound(substrate,zmax)
thermo_style    custom step pe evdwl ecoul elong
thermo          1
run             0
print           "MERGED atoms $(count(all)) substrate_top $(v_sub_top) polymer $(v_poly_lo) .. $(v_poly_hi)"
print           "MERGED gap $(v_gap0) pe $(pe)"

write_data      05_interface_merged.data
