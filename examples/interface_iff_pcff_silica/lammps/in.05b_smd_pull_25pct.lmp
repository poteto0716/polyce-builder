# Constant-velocity SMD pull of the fixed upper-25%-of-thickness grip prepared
# by in.05a_smd_frames_25pct.lmp.  The initial stationary spring and the moving
# spring have the same K and tether origin.

variable restart     index frame_0.restart
variable rep         index 1
variable n_sub       index 11712
variable T           index 300.0
variable TDAMP       index 100.0
variable DT          index 1.0
variable K           index 100.0
variable VEL         index 0.0005
variable Z0          index 100.0
variable N_PULL      index 120000
variable SUB_XH      index 3
variable POLY_XH1    index 8
variable POLY_XH2    index 15
variable POLY_XH3    index 18
variable FIX_THICK   index 3.0
variable PRINT_EVERY index 100
variable DUMP_EVERY  index 2000

read_restart    ${restart}

# A restart restores the long-range pair style but not an active solver.
kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

group           substrate id 1:${n_sub}
group           polymer subtract all substrate
variable        zFixHi equal bound(substrate,zmin)+${FIX_THICK}
region          R_FIXED block INF INF INF INF INF ${zFixHi} units box
group           in_fixed region R_FIXED
group           frozen intersect substrate in_fixed
group           mobile subtract all frozen
velocity        frozen set 0.0 0.0 0.0
fix             FREEZE frozen setforce 0.0 0.0 0.0
fix             REFLECT all wall/reflect zlo EDGE zhi EDGE

# `grip` is restored from the frame restart.  Its fixed bit membership is the
# same in all replicas even though atoms have moved during frame generation.
variable        Ngrip equal count(grip)
variable        Npolymer equal count(polymer)
variable        Mgrip equal mass(grip)
if "${Ngrip} < 1" then "print 'restart has no SMD grip group'" "quit 1"

timestep        ${DT}
fix             XH all shake 1.0e-6 200 5000 b ${SUB_XH} ${POLY_XH1} ${POLY_XH2} ${POLY_XH3}
fix             NVT mobile nvt temp ${T} ${T} ${TDAMP}

# U = 1/2 K [z_tether(t)-z_COM]^2.  Its group force is distributed by mass,
# which is the exact gradient of a centre-of-mass collective coordinate.
variable        step0 equal $(step)
variable        ztet equal ${Z0}+${VEL}*(step-v_step0)*dt
variable        zcm equal xcm(grip,z)
variable        target equal ${VEL}*(step-v_step0)*dt
variable        fspr equal ${K}*(v_ztet-v_zcm)
variable        fatom atom v_fspr*mass/v_Mgrip
variable        uspr atom 0.5*${K}*(v_ztet-v_zcm)^2*mass/v_Mgrip
fix             PULL grip addforce 0.0 0.0 v_fatom energy v_uspr
fix_modify      PULL energy yes

variable        tps equal (step-v_step0)*dt/1000.0
variable        sep equal xcm(polymer,z)-xcm(substrate,z)
variable        area equal lx*ly
thermo          1000
thermo_style    custom step time temp pe ke etotal v_target v_zcm v_fspr v_sep
thermo_modify   flush yes

fix             POUT all print ${PRINT_EVERY} "$(step),${tps},${target},${ztet},${zcm},${sep},${fspr},${area}" file pull_${rep}.csv screen no title "step,time_ps,pull_target_A,tether_z_A,grip_com_z_A,polymer_substrate_COM_separation_A,pull_force_z_kcal_mol_A,interface_area_A2"
dump            DP all custom ${DUMP_EVERY} pull_${rep}.lammpstrj id mol type q xu yu zu vx vy vz fx fy fz
dump_modify     DP sort id first yes

run             ${N_PULL}
print           "SMD_PULL_DONE replica ${rep} target_A ${target} grip_atoms ${Ngrip} polymer_atoms ${Npolymer}"
