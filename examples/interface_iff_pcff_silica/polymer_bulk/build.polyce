polyce-build 1
name          smoke_polymer
seed          1234
sequence_seed 7
forcefield    ../../common/iff_bulk.ff
cell          40.3148 41.4320 34.245854
periodic      1 1 1
monomer       A '*CC(C)(C(=O)OC)*'
terminator    '*C'
